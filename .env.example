# Supabase — client (publishable) values. These are bundled into the app and are not secrets,
# but the file itself is gitignored so a private key is never committed here by mistake.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# OpenWeather — free-tier key for the Vaal Dam widget on the member portal.
VITE_OPENWEATHER_API_KEY=
