# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloudflare Pages builds with npm — never commit a bun lockfile (it triggers a frozen bun install)
bun.lock
bun.lockb

# Supabase CLI cache
supabase/.temp/

# Env files (all VITE_ vars ship in the bundle; keep the file itself out of git)
.env
.env.*
!.env.example

# Local Supabase access token (never commit)
.env.supabase

# Claude Code local state — worktrees hold a full repo copy incl. .env
.claude/worktrees/
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
